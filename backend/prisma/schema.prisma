  actualAddress         String   // Р В¤Р В°Р С”РЎвЂљР С‘РЎвЂЎР ВµРЎРѓР С”Р С‘Р в„– Р В°Р Т‘РЎР‚Р ВµРЎРѓ
  dormitoryAddress      String   // Р С’Р Т‘РЎР‚Р ВµРЎРѓ Р С•Р В±РЎвЂ°Р ВµР В¶Р С‘РЎвЂљР С‘РЎРЏ
  workSchedule          String   // Р В Р ВµР В¶Р С‘Р С РЎР‚Р В°Р В±Р С•РЎвЂљРЎвЂ№
  directorName          String   // Р В¤Р ВР С› Р Т‘Р С‘РЎР‚Р ВµР С”РЎвЂљР С•РЎР‚Р В°
  directorPhone         String   // Р СћР ВµР В»Р ВµРЎвЂћР С•Р Р… Р Т‘Р С‘РЎР‚Р ВµР С”РЎвЂљР С•РЎР‚Р В°
  deputyDirectorPhone   String   // Р СћР ВµР В»Р ВµРЎвЂћР С•Р Р… Р В·Р В°Р С. Р Т‘Р С‘РЎР‚Р ВµР С”РЎвЂљР С•РЎР‚Р В°
  educationPhone        String   // Р СћР ВµР В»Р ВµРЎвЂћР С•Р Р… РЎС“РЎвЂЎР ВµР В±Р Р…Р С•Р в„– РЎвЂЎР В°РЎРѓРЎвЂљР С‘
  hrPhone               String   // Р СћР ВµР В»Р ВµРЎвЂћР С•Р Р… Р С•РЎвЂљР Т‘Р ВµР В»Р В° Р С”Р В°Р Т‘РЎР‚Р С•Р Р†
  accountingPhone       String   // Р СћР ВµР В»Р ВµРЎвЂћР С•Р Р… Р В±РЎС“РЎвЂ¦Р С–Р В°Р В»РЎвЂљР ВµРЎР‚Р С‘Р С‘
  email                 String   // Email Р С•РЎР‚Р С–Р В°Р Р…Р С‘Р В·Р В°РЎвЂ Р С‘Р С‘
  website               String   // Р С›РЎвЂћР С‘РЎвЂ Р С‘Р В°Р В»РЎРЉР Р…РЎвЂ№Р в„– РЎРѓР В°Р в„–РЎвЂљ
  activityAddress       String   // Р СљР ВµРЎРѓРЎвЂљР С• Р С•РЎРѓРЎС“РЎвЂ°Р ВµРЎРѓРЎвЂљР Р†Р В»Р ВµР Р…Р С‘РЎРЏ Р Т‘Р ВµРЎРЏРЎвЂљР ВµР В»РЎРЉР Р…Р С•РЎРѓРЎвЂљР С‘
  accreditationSeries   String   // Р РЋР ВµРЎР‚Р С‘РЎРЏ РЎРѓР Р†Р С‘Р Т‘Р ВµРЎвЂљР ВµР В»РЎРЉРЎРѓРЎвЂљР Р†Р В° Р В°Р С”Р С”РЎР‚Р ВµР Т‘Р С‘РЎвЂљР В°РЎвЂ Р С‘Р С‘
  accreditationNumber   String   // Р СњР С•Р СР ВµРЎР‚ РЎРѓР Р†Р С‘Р Т‘Р ВµРЎвЂљР ВµР В»РЎРЉРЎРѓРЎвЂљР Р†Р В° Р В°Р С”Р С”РЎР‚Р ВµР Т‘Р С‘РЎвЂљР В°РЎвЂ Р С‘Р С‘
  accreditationRegNum   String   // Р В Р ВµР С–Р С‘РЎРѓРЎвЂљРЎР‚Р В°РЎвЂ Р С‘Р С•Р Р…Р Р…РЎвЂ№Р в„– Р Р…Р С•Р СР ВµРЎР‚ Р В°Р С”Р С”РЎР‚Р ВµР Т‘Р С‘РЎвЂљР В°РЎвЂ Р С‘Р С‘
  accreditationDate     String   // Р вЂќР В°РЎвЂљР В° Р Р†РЎвЂ№Р Т‘Р В°РЎвЂЎР С‘ Р В°Р С”Р С”РЎР‚Р ВµР Т‘Р С‘РЎвЂљР В°РЎвЂ Р С‘Р С‘
  accreditationExpiry   String   // Р РЋРЎР‚Р С•Р С” Р Т‘Р ВµР в„–РЎРѓРЎвЂљР Р†Р С‘РЎРЏ Р В°Р С”Р С”РЎР‚Р ВµР Т‘Р С‘РЎвЂљР В°РЎвЂ Р С‘Р С‘
  licenseSeries         String   // Р РЋР ВµРЎР‚Р С‘РЎРЏ Р В»Р С‘РЎвЂ Р ВµР Р…Р В·Р С‘Р С‘
  licenseNumber         String   // Р СњР С•Р СР ВµРЎР‚ Р В»Р С‘РЎвЂ Р ВµР Р…Р В·Р С‘Р С‘
  licenseExpiry         String   // Р РЋРЎР‚Р С•Р С” Р Т‘Р ВµР в„–РЎРѓРЎвЂљР Р†Р С‘РЎРЏ Р В»Р С‘РЎвЂ Р ВµР Р…Р В·Р С‘Р С‘
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model HomeSlider {
  id          String   @id @default(uuid())
  title       String   // Р вЂ”Р В°Р С–Р С•Р В»Р С•Р Р†Р С•Р С” РЎРѓР В»Р В°Р в„–Р Т‘Р В°
  subtitle    String?  // Р СџР С•Р Т‘Р В·Р В°Р С–Р С•Р В»Р С•Р Р†Р С•Р С”
  imageUrl    String   // URL Р С‘Р В·Р С•Р В±РЎР‚Р В°Р В¶Р ВµР Р…Р С‘РЎРЏ
  link        String?  // Р РЋРЎРѓРЎвЂ№Р В»Р С”Р В° Р С—РЎР‚Р С‘ Р С”Р В»Р С‘Р С”Р Вµ
  order       Int      @default(0) // Р СџР С•РЎР‚РЎРЏР Т‘Р С•Р С” Р С•РЎвЂљР С•Р В±РЎР‚Р В°Р В¶Р ВµР Р…Р С‘РЎРЏ
  isActive    Boolean  @default(true) // Р С’Р С”РЎвЂљР С‘Р Р†Р ВµР Р… Р В»Р С‘ РЎРѓР В»Р В°Р в„–Р Т‘
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomPage {
  id             String             @id @default(uuid())
  title          String
  slug           String             @unique
  description    String?
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  blocks         CustomPageBlock[]
}

model CustomPageBlock {
  id        String     @id @default(uuid())
  pageId    String
  page      CustomPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String
  data      Json
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
model StudentLifeItem {
  id          String   @id @default(uuid())
  title       String   // Р СњР В°Р В·Р Р†Р В°Р Р…Р С‘Р Вµ Р СР ВµРЎР‚Р С•Р С—РЎР‚Р С‘РЎРЏРЎвЂљР С‘РЎРЏ/Р В°Р С”РЎвЂљР С‘Р Р†Р Р…Р С•РЎРѓРЎвЂљР С‘
  description String   // Р С›Р С—Р С‘РЎРѓР В°Р Р…Р С‘Р Вµ
  images      String[] // Р СљР В°РЎРѓРЎРѓР С‘Р Р† Р С‘Р СР ВµР Р… РЎвЂћР В°Р в„–Р В»Р С•Р Р† Р С‘Р В·Р С•Р В±РЎР‚Р В°Р В¶Р ВµР Р…Р С‘Р в„–
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudentDiscipline {
  id          String               @id @default(uuid())
  title       String
  description String?
  order       Int                  @default(0)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  materials   DisciplineMaterial[]
}

model DisciplineMaterial {
  id           String            @id @default(uuid())
  disciplineId String
  discipline   StudentDiscipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  title        String
  fileUrl      String
  fileName     String
  fileSize     Int?
  fileType     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Structure {
