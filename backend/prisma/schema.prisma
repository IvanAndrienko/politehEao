  founderEmail          String   // Email РЎС“РЎвЂЎРЎР‚Р ВµР Т‘Р С‘РЎвЂљР ВµР В»РЎРЏ
  founderWebsite        String   // Р РЋР В°Р в„–РЎвЂљ РЎС“РЎвЂЎРЎР‚Р ВµР Т‘Р С‘РЎвЂљР ВµР В»РЎРЏ
