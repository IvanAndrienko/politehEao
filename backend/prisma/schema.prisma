  practices     String?  // РџСЂР°РєС‚РёРєРё
  documents     String?  // РњРµС‚РѕРґРёС‡РµСЃРєРёРµ РґРѕРєСѓРјРµРЅС‚С‹
  order         Int      @default(0) // РџРѕСЂСЏРґРѕРє РѕС‚РѕР±СЂР°Р¶РµРЅРёСЏ
  isActive      Boolean  @default(true) // РђРєС‚РёРІРЅР° Р»Рё РїСЂРѕРіСЂР°РјРјР°
  createdAt     DateTime @default(now())
