}

model DisciplineMaterial {
  id           String            @id @default(uuid())
  disciplineId String
  discipline   StudentDiscipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  title        String
  fileUrl      String
  fileName     String
  fileSize     Int?
  fileType     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Structure {
  id                    Int       @id @default(autoincrement())
  managementInfo        String?  // Р СѓРєРѕРІРѕРґРёС‚РµР»СЊ
  managementInfo2       String?  // РљРѕР»Р»РµРіРёР°Р»СЊРЅС‹Рµ РѕСЂРіР°РЅС‹ СѓРїСЂР°РІР»РµРЅРёСЏ
  managementLocation    String?  // РњРµСЃС‚Рѕ РЅР°С…РѕР¶РґРµРЅРёСЏ РѕСЂРіР°РЅРѕРІ СѓРїСЂР°РІР»РµРЅРёСЏ
  managementContacts    String?  // РљРѕРЅС‚Р°РєС‚С‹ РѕСЂРіР°РЅРѕРІ СѓРїСЂР°РІР»РµРЅРёСЏ
  hasFilials           Boolean   @default(false)
  filials              String[] // РњР°СЃСЃРёРІ С„РёР»РёР°Р»РѕРІ (JSON СЃС‚СЂРѕРєРё)
  hasRepresentatives   Boolean   @default(false)
  representatives      String[] // РњР°СЃСЃРёРІ РїСЂРµРґСЃС‚Р°РІРёС‚РµР»СЊСЃС‚РІ (JSON СЃС‚СЂРѕРєРё)
  departments          Department[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Department {
  id            String     @id @default(uuid())
  structureId   Int
  structure     Structure  @relation(fields: [structureId], references: [id], onDelete: Cascade)
  name          String     // РќР°РёРјРµРЅРѕРІР°РЅРёРµ РѕСЂРіР°РЅР° СѓРїСЂР°РІР»РµРЅРёСЏ / СЃС‚СЂСѓРєС‚СѓСЂРЅРѕРіРѕ РїРѕРґСЂР°Р·РґРµР»РµРЅРёСЏ
  fio           String     // Р¤РРћ СЂСѓРєРѕРІРѕРґРёС‚РµР»СЏ
  post          String     // Р”РѕР»Р¶РЅРѕСЃС‚СЊ СЂСѓРєРѕРІРѕРґРёС‚РµР»СЏ
  phone         String?    // РљРѕРЅС‚Р°РєС‚РЅС‹Р№ С‚РµР»РµС„РѕРЅ
  address       String     // РђРґСЂРµСЃ РјРµСЃС‚РѕРЅР°С…РѕР¶РґРµРЅРёСЏ
  site          String     // РђРґСЂРµСЃ РѕС„РёС†РёР°Р»СЊРЅРѕРіРѕ СЃР°Р№С‚Р°
  email         String     // РђРґСЂРµСЃР° СЌР»РµРєС‚СЂРѕРЅРЅРѕР№ РїРѕС‡С‚С‹
  document      String?    // РџРѕР»РѕР¶РµРЅРёРµ РѕР± РѕСЂРіР°РЅРµ СѓРїСЂР°РІР»РµРЅРёСЏ/ Рѕ СЃС‚СЂСѓРєС‚СѓСЂРЅРѕРј РїРѕРґСЂР°Р·РґРµР»РµРЅРёРё
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model StructureDocument {
  id          String   @id @default(uuid())
  title       String   // РќР°Р·РІР°РЅРёРµ РґРѕРєСѓРјРµРЅС‚Р°
  description String?  // РћРїРёСЃР°РЅРёРµ РґРѕРєСѓРјРµРЅС‚Р°
  fileUrl     String   // РџСѓС‚СЊ Рє С„Р°Р№Р»Сѓ
  fileName    String   // РћСЂРёРіРёРЅР°Р»СЊРЅРѕРµ РёРјСЏ С„Р°Р№Р»Р°
  fileSize    Int      // Р Р°Р·РјРµСЂ С„Р°Р№Р»Р° РІ Р±Р°Р№С‚Р°С…
  fileType    String   // MIME С‚РёРї С„Р°Р№Р»Р°
  isActive    Boolean  @default(true) // РђРєС‚РёРІРµРЅ Р»Рё РґРѕРєСѓРјРµРЅС‚
  order       Int      @default(0) // РџРѕСЂСЏРґРѕРє РѕС‚РѕР±СЂР°Р¶РµРЅРёСЏ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Document {
  id          String   @id @default(uuid())
  field       String   @unique // РџРѕР»Рµ РґРѕРєСѓРјРµРЅС‚Р° (ustavDocLink, localActStud Рё С‚.Рґ.)
  fileUrl     String   // РџСѓС‚СЊ Рє С„Р°Р№Р»Сѓ
  fileName    String   // РћСЂРёРіРёРЅР°Р»СЊРЅРѕРµ РёРјСЏ С„Р°Р№Р»Р°
  fileSize    Int      // Р Р°Р·РјРµСЂ С„Р°Р№Р»Р° РІ Р±Р°Р№С‚Р°С…
  fileType    String   // MIME С‚РёРї С„Р°Р№Р»Р°
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EducationalProgram {
  id            String   @id @default(uuid())
  code          String   // РљРѕРґ, С€РёС„СЂ РїСЂРѕРіСЂР°РјРјС‹
  name          String   // РќР°РёРјРµРЅРѕРІР°РЅРёРµ РїСЂРѕРіСЂР°РјРјС‹
  level         String   // РЈСЂРѕРІРµРЅСЊ РѕР±СЂР°Р·РѕРІР°РЅРёСЏ
