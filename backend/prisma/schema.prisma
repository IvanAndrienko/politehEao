generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model News {
  // РќРѕРІРѕСЃС‚Рё СЃР°Р№С‚Р°
  id                Int      @id @default(autoincrement())
  title             String
  slug              String   @unique
  shortDescription  String?  @db.Text
  fullText          String   @db.Text
  previewImage      String?
  attachments       String[] // РњР°СЃСЃРёРІ URL С„Р°Р№Р»РѕРІ/РґРѕРєСѓРјРµРЅС‚РѕРІ
  images            String[] // РњР°СЃСЃРёРІ URL РёР·РѕР±СЂР°Р¶РµРЅРёР№ РґР»СЏ РЅРѕРІРѕСЃС‚Рё
  publishedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Admin {
  // РђРґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂС‹ СЃРёСЃС‚РµРјС‹
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model SiteSettings {
  // РќР°СЃС‚СЂРѕР№РєРё СЃР°Р№С‚Р° (РєРѕРЅС‚Р°РєС‚С‹, СЃРѕС†СЃРµС‚Рё)
  id        Int      @id @default(autoincrement())
  phone     String?
  email     String?
  address   String?
  vkLink    String?
  telegram  String?
  updatedAt DateTime @updatedAt
}

model Specialty {
  // РЎРїРµС†РёР°Р»СЊРЅРѕСЃС‚Рё РґР»СЏ РїРѕСЃС‚СѓРїР»РµРЅРёСЏ
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  duration      String?
  form          String?
  qualification String?
  budgetPlaces  Int?
  paidPlaces    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RequiredDocument {
  // Р”РѕРєСѓРјРµРЅС‚С‹ РґР»СЏ РїРѕСЃС‚СѓРїР»РµРЅРёСЏ
  id          String   @id @default(uuid())
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ImportantDate {
  // Р’Р°Р¶РЅС‹Рµ РґР°С‚С‹ РїРѕСЃС‚СѓРїР»РµРЅРёСЏ
  id        String   @id @default(uuid())
  date      String
  event     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdmissionContact {
  // РљРѕРЅС‚Р°РєС‚С‹ РґР»СЏ РїРѕСЃС‚СѓРїР»РµРЅРёСЏ
  id        String   @id @default(uuid())
  type      String   // 'phone', 'email', 'address', 'schedule'
  title     String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dormitory {
  id          Int      @id @default(autoincrement())
  description String?
  address     String?
  images      String[] // РњР°СЃСЃРёРІ URL РёР·РѕР±СЂР°Р¶РµРЅРёР№
  updatedAt   DateTime @updatedAt
}

model StudyGroup {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  fullName      String
  specialty     String?
  lessons       Lesson[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Lesson {
  id            String     @id @default(uuid())
  groupId       String
  group         StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dayOfWeek     Int        // 1-5 (РїРѕРЅРµРґРµР»СЊРЅРёРє-РїСЏС‚РЅРёС†Р°)
  lessonNumber  Int        // 1-5 (РЅРѕРјРµСЂ РїР°СЂС‹)
  subject       String
  teacher       String
  room          String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  date        DateTime @default(now())
  isUrgent    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudentService {
  id          String   @id @default(uuid())
  title       String   // РќР°Р·РІР°РЅРёРµ РјРµСЂРѕРїСЂРёСЏС‚РёСЏ/Р°РєС‚РёРІРЅРѕСЃС‚Рё
  description String   // РћРїРёСЃР°РЅРёРµ
  url         String?  // URL СЃСЃС‹Р»РєР° РґР»СЏ РїРµСЂРµРЅР°РїСЂР°РІР»РµРЅРёСЏ
  icon        String   // РќР°Р·РІР°РЅРёРµ РёРєРѕРЅРєРё (РЅР°РїСЂРёРјРµСЂ, 'FaHome')
  order       Int      @default(0) // РџРѕСЂСЏРґРѕРє РѕС‚РѕР±СЂР°Р¶РµРЅРёСЏ
  isActive    Boolean  @default(true) // РђРєС‚РёРІРµРЅ Р»Рё СЃРµСЂРІРёСЃ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudentDocument {
  id          String   @id @default(uuid())
  title       String   // РќР°Р·РІР°РЅРёРµ РґРѕРєСѓРјРµРЅС‚Р°
  description String?  // РћРїРёСЃР°РЅРёРµ
  fileUrl     String   // РџСѓС‚СЊ Рє С„Р°Р№Р»Сѓ РІ uploads/documents/
  fileName    String   // РћСЂРёРіРёРЅР°Р»СЊРЅРѕРµ РёРјСЏ С„Р°Р№Р»Р°
  fileSize    Int      // Р Р°Р·РјРµСЂ С„Р°Р№Р»Р° РІ Р±Р°Р№С‚Р°С…
  fileType    String   // MIME С‚РёРї С„Р°Р№Р»Р°
  category    String?  // РљР°С‚РµРіРѕСЂРёСЏ РґРѕРєСѓРјРµРЅС‚Р° (СЃРїСЂР°РІРєРё, Р·Р°СЏРІР»РµРЅРёСЏ Рё С‚.Рґ.)
  isActive    Boolean  @default(true) // РђРєС‚РёРІРµРЅ Р»Рё РґРѕРєСѓРјРµРЅС‚
  order       Int      @default(0)    // РџРѕСЂСЏРґРѕРє РѕС‚РѕР±СЂР°Р¶РµРЅРёСЏ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrganizationInfo {
  id                    Int      @id @default(autoincrement())
  fullName              String   // РџРѕР»РЅРѕРµ РЅР°РёРјРµРЅРѕРІР°РЅРёРµ
  shortName             String   // РЎРѕРєСЂР°С‰РµРЅРЅРѕРµ РЅР°РёРјРµРЅРѕРІР°РЅРёРµ
  creationDate          String   // Р”Р°С‚Р° СЃРѕР·РґР°РЅРёСЏ
  founderName           String   // РќР°РёРјРµРЅРѕРІР°РЅРёРµ СѓС‡СЂРµРґРёС‚РµР»СЏ
  founderAddress        String   // РђРґСЂРµСЃ СѓС‡СЂРµРґРёС‚РµР»СЏ
  founderPhone          String   // РўРµР»РµС„РѕРЅ СѓС‡СЂРµРґРёС‚РµР»СЏ
  founderEmail          String   // Email СѓС‡СЂРµРґРёС‚РµР»СЏ
  founderWebsite        String   // РЎР°Р№С‚ СѓС‡СЂРµРґРёС‚РµР»СЏ
  legalAddress          String   // Р®СЂРёРґРёС‡РµСЃРєРёР№ Р°РґСЂРµСЃ
  actualAddress         String   // Р¤Р°РєС‚РёС‡РµСЃРєРёР№ Р°РґСЂРµСЃ
  dormitoryAddress      String   // РђРґСЂРµСЃ РѕР±С‰РµР¶РёС‚РёСЏ
  workSchedule          String   // Р РµР¶РёРј СЂР°Р±РѕС‚С‹
  directorName          String   // Р¤РРћ РґРёСЂРµРєС‚РѕСЂР°
  directorPhone         String   // РўРµР»РµС„РѕРЅ РґРёСЂРµРєС‚РѕСЂР°
  deputyDirectorPhone   String   // РўРµР»РµС„РѕРЅ Р·Р°Рј. РґРёСЂРµРєС‚РѕСЂР°
  educationPhone        String   // РўРµР»РµС„РѕРЅ СѓС‡РµР±РЅРѕР№ С‡Р°СЃС‚Рё
  hrPhone               String   // РўРµР»РµС„РѕРЅ РѕС‚РґРµР»Р° РєР°РґСЂРѕРІ
  accountingPhone       String   // РўРµР»РµС„РѕРЅ Р±СѓС…РіР°Р»С‚РµСЂРёРё
  email                 String   // Email РѕСЂРіР°РЅРёР·Р°С†РёРё
  website               String   // РћС„РёС†РёР°Р»СЊРЅС‹Р№ СЃР°Р№С‚
  activityAddress       String   // РњРµСЃС‚Рѕ РѕСЃСѓС‰РµСЃС‚РІР»РµРЅРёСЏ РґРµСЏС‚РµР»СЊРЅРѕСЃС‚Рё
  accreditationSeries   String   // РЎРµСЂРёСЏ СЃРІРёРґРµС‚РµР»СЊСЃС‚РІР° Р°РєРєСЂРµРґРёС‚Р°С†РёРё
  accreditationNumber   String   // РќРѕРјРµСЂ СЃРІРёРґРµС‚РµР»СЊСЃС‚РІР° Р°РєРєСЂРµРґРёС‚Р°С†РёРё
  accreditationRegNum   String   // Р РµРіРёСЃС‚СЂР°С†РёРѕРЅРЅС‹Р№ РЅРѕРјРµСЂ Р°РєРєСЂРµРґРёС‚Р°С†РёРё
  accreditationDate     String   // Р”Р°С‚Р° РІС‹РґР°С‡Рё Р°РєРєСЂРµРґРёС‚Р°С†РёРё
  accreditationExpiry   String   // РЎСЂРѕРє РґРµР№СЃС‚РІРёСЏ Р°РєРєСЂРµРґРёС‚Р°С†РёРё
