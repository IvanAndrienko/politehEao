model HomeSlider {
  id          String   @id @default(uuid())
  title       String   // Р—Р°РіРѕР»РѕРІРѕРє СЃР»Р°Р№РґР°
  subtitle    String?  // РџРѕРґР·Р°РіРѕР»РѕРІРѕРє
  imageUrl    String   // URL РёР·РѕР±СЂР°Р¶РµРЅРёСЏ
  link        String?  // РЎСЃС‹Р»РєР° РїСЂРё РєР»РёРєРµ
  order       Int      @default(0) // РџРѕСЂСЏРґРѕРє РѕС‚РѕР±СЂР°Р¶РµРЅРёСЏ
  isActive    Boolean  @default(true) // РђРєС‚РёРІРµРЅ Р»Рё СЃР»Р°Р№Рґ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudentLifeItem {
  id          String   @id @default(uuid())
  title       String   // РќР°Р·РІР°РЅРёРµ РјРµСЂРѕРїСЂРёСЏС‚РёСЏ/Р°РєС‚РёРІРЅРѕСЃС‚Рё
  description String   // РћРїРёСЃР°РЅРёРµ
