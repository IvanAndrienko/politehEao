// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model News {
  // Р СњР С•Р Р†Р С•РЎРѓРЎвЂљР С‘ РЎРѓР В°Р в„–РЎвЂљР В°
  id                Int      @id @default(autoincrement())
  title             String
  slug              String   @unique
  shortDescription  String?  @db.Text
  fullText          String   @db.Text
  previewImage      String?
  attachments       String[] // Р СљР В°РЎРѓРЎРѓР С‘Р Р† URL РЎвЂћР В°Р в„–Р В»Р С•Р Р†/Р Т‘Р С•Р С”РЎС“Р СР ВµР Р…РЎвЂљР С•Р Р†
  images            String[] // Р СљР В°РЎРѓРЎРѓР С‘Р Р† URL Р С‘Р В·Р С•Р В±РЎР‚Р В°Р В¶Р ВµР Р…Р С‘Р в„– Р Т‘Р В»РЎРЏ Р Р…Р С•Р Р†Р С•РЎРѓРЎвЂљР С‘
  publishedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Admin {
  // Р С’Р Т‘Р СР С‘Р Р…Р С‘РЎРѓРЎвЂљРЎР‚Р В°РЎвЂљР С•РЎР‚РЎвЂ№ РЎРѓР С‘РЎРѓРЎвЂљР ВµР СРЎвЂ№
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model SiteSettings {
  // Р СњР В°РЎРѓРЎвЂљРЎР‚Р С•Р в„–Р С”Р С‘ РЎРѓР В°Р в„–РЎвЂљР В° (Р С”Р С•Р Р…РЎвЂљР В°Р С”РЎвЂљРЎвЂ№, РЎРѓР С•РЎвЂ РЎРѓР ВµРЎвЂљР С‘)
  id        Int      @id @default(autoincrement())
  phone     String?
  email     String?
  address   String?
  vkLink    String?
  telegram  String?
  updatedAt DateTime @updatedAt
}

model Specialty {
  // Р РЋР С—Р ВµРЎвЂ Р С‘Р В°Р В»РЎРЉР Р…Р С•РЎРѓРЎвЂљР С‘ Р Т‘Р В»РЎРЏ Р С—Р С•РЎРѓРЎвЂљРЎС“Р С—Р В»Р ВµР Р…Р С‘РЎРЏ
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  duration      String?
  form          String?
  qualification String?
  budgetPlaces  Int?
  paidPlaces    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RequiredDocument {
  // Р вЂќР С•Р С”РЎС“Р СР ВµР Р…РЎвЂљРЎвЂ№ Р Т‘Р В»РЎРЏ Р С—Р С•РЎРѓРЎвЂљРЎС“Р С—Р В»Р ВµР Р…Р С‘РЎРЏ
  id          String   @id @default(uuid())
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ImportantDate {
  // Р вЂ™Р В°Р В¶Р Р…РЎвЂ№Р Вµ Р Т‘Р В°РЎвЂљРЎвЂ№ Р С—Р С•РЎРѓРЎвЂљРЎС“Р С—Р В»Р ВµР Р…Р С‘РЎРЏ
  id        String   @id @default(uuid())
  date      String
  event     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdmissionContact {
  // Р С™Р С•Р Р…РЎвЂљР В°Р С”РЎвЂљРЎвЂ№ Р Т‘Р В»РЎРЏ Р С—Р С•РЎРѓРЎвЂљРЎС“Р С—Р В»Р ВµР Р…Р С‘РЎРЏ
  id        String   @id @default(uuid())
  type      String   // 'phone', 'email', 'address', 'schedule'
  title     String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dormitory {
  id          Int      @id @default(autoincrement())
  description String?
  address     String?
  images      String[] // Р СљР В°РЎРѓРЎРѓР С‘Р Р† URL Р С‘Р В·Р С•Р В±РЎР‚Р В°Р В¶Р ВµР Р…Р С‘Р в„–
  updatedAt   DateTime @updatedAt
}

model StudyGroup {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  fullName      String
  specialty     String?
  lessons       Lesson[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Lesson {
  id            String     @id @default(uuid())
  groupId       String
  group         StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dayOfWeek     Int        // 1-5 (Р С—Р С•Р Р…Р ВµР Т‘Р ВµР В»РЎРЉР Р…Р С‘Р С”-Р С—РЎРЏРЎвЂљР Р…Р С‘РЎвЂ Р В°)
  lessonNumber  Int        // 1-5 (Р Р…Р С•Р СР ВµРЎР‚ Р С—Р В°РЎР‚РЎвЂ№)
  subject       String
  teacher       String
  room          String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  date        DateTime @default(now())
  isUrgent    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudentService {
  id          String   @id @default(uuid())
  title       String   // Р СњР В°Р В·Р Р†Р В°Р Р…Р С‘Р Вµ Р СР ВµРЎР‚Р С•Р С—РЎР‚Р С‘РЎРЏРЎвЂљР С‘РЎРЏ/Р В°Р С”РЎвЂљР С‘Р Р†Р Р…Р С•РЎРѓРЎвЂљР С‘
  description String   // Р С›Р С—Р С‘РЎРѓР В°Р Р…Р С‘Р Вµ
  url         String?  // URL РЎРѓРЎРѓРЎвЂ№Р В»Р С”Р В° Р Т‘Р В»РЎРЏ Р С—Р ВµРЎР‚Р ВµР Р…Р В°Р С—РЎР‚Р В°Р Р†Р В»Р ВµР Р…Р С‘РЎРЏ
  icon        String   // Р СњР В°Р В·Р Р†Р В°Р Р…Р С‘Р Вµ Р С‘Р С”Р С•Р Р…Р С”Р С‘ (Р Р…Р В°Р С—РЎР‚Р С‘Р СР ВµРЎР‚, 'FaHome')
  order       Int      @default(0) // Р СџР С•РЎР‚РЎРЏР Т‘Р С•Р С” Р С•РЎвЂљР С•Р В±РЎР‚Р В°Р В¶Р ВµР Р…Р С‘РЎРЏ
  isActive    Boolean  @default(true) // Р С’Р С”РЎвЂљР С‘Р Р†Р ВµР Р… Р В»Р С‘ РЎРѓР ВµРЎР‚Р Р†Р С‘РЎРѓ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudentDocument {
  id          String   @id @default(uuid())
  title       String   // Р СњР В°Р В·Р Р†Р В°Р Р…Р С‘Р Вµ Р Т‘Р С•Р С”РЎС“Р СР ВµР Р…РЎвЂљР В°
  description String?  // Р С›Р С—Р С‘РЎРѓР В°Р Р…Р С‘Р Вµ
  fileUrl     String   // Р СџРЎС“РЎвЂљРЎРЉ Р С” РЎвЂћР В°Р в„–Р В»РЎС“ Р Р† uploads/documents/
  fileName    String   // Р С›РЎР‚Р С‘Р С–Р С‘Р Р…Р В°Р В»РЎРЉР Р…Р С•Р Вµ Р С‘Р СРЎРЏ РЎвЂћР В°Р в„–Р В»Р В°
  fileSize    Int      // Р В Р В°Р В·Р СР ВµРЎР‚ РЎвЂћР В°Р в„–Р В»Р В° Р Р† Р В±Р В°Р в„–РЎвЂљР В°РЎвЂ¦
  fileType    String   // MIME РЎвЂљР С‘Р С— РЎвЂћР В°Р в„–Р В»Р В°
  category    String?  // Р С™Р В°РЎвЂљР ВµР С–Р С•РЎР‚Р С‘РЎРЏ Р Т‘Р С•Р С”РЎС“Р СР ВµР Р…РЎвЂљР В° (РЎРѓР С—РЎР‚Р В°Р Р†Р С”Р С‘, Р В·Р В°РЎРЏР Р†Р В»Р ВµР Р…Р С‘РЎРЏ Р С‘ РЎвЂљ.Р Т‘.)
  isActive    Boolean  @default(true) // Р С’Р С”РЎвЂљР С‘Р Р†Р ВµР Р… Р В»Р С‘ Р Т‘Р С•Р С”РЎС“Р СР ВµР Р…РЎвЂљ
  order       Int      @default(0)    // Р СџР С•РЎР‚РЎРЏР Т‘Р С•Р С” Р С•РЎвЂљР С•Р В±РЎР‚Р В°Р В¶Р ВµР Р…Р С‘РЎРЏ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrganizationInfo {
  id                    Int      @id @default(autoincrement())
  fullName              String   // Р СџР С•Р В»Р Р…Р С•Р Вµ Р Р…Р В°Р С‘Р СР ВµР Р…Р С•Р Р†Р В°Р Р…Р С‘Р Вµ
  shortName             String   // Р РЋР С•Р С”РЎР‚Р В°РЎвЂ°Р ВµР Р…Р Р…Р С•Р Вµ Р Р…Р В°Р С‘Р СР ВµР Р…Р С•Р Р†Р В°Р Р…Р С‘Р Вµ
  creationDate          String   // Р вЂќР В°РЎвЂљР В° РЎРѓР С•Р В·Р Т‘Р В°Р Р…Р С‘РЎРЏ
  founderName           String   // Р СњР В°Р С‘Р СР ВµР Р…Р С•Р Р†Р В°Р Р…Р С‘Р Вµ РЎС“РЎвЂЎРЎР‚Р ВµР Т‘Р С‘РЎвЂљР ВµР В»РЎРЏ
  founderAddress        String   // Р С’Р Т‘РЎР‚Р ВµРЎРѓ РЎС“РЎвЂЎРЎР‚Р ВµР Т‘Р С‘РЎвЂљР ВµР В»РЎРЏ
